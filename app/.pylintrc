[MASTER]
indent-string='    '
ignore-paths=.*/\.venv/.*,.*/__pycache__/.*,.*/node_modules/.*

[FORMAT]
indent-string='    '
indent-after-paren=2
max-line-length=100

[MESSAGES CONTROL]
disable=
    import-error,
    no-name-in-module,
    too-few-public-methods,
    too-many-arguments,
    too-many-locals,
    too-many-branches,
    too-many-statements,
    broad-except,
    missing-docstring,
    line-too-long

[DESIGN]
max-args=10
max-locals=20
max-returns=6
max-branches=15
max-statements=60
max-parents=7
max-attributes=10
max-public-methods=20
min-public-methods=1

[VARIABLES]
init-import=no
dummy-variables-rgx=_+$|(_[a-zA-Z0-9_]*[a-zA-Z0-9]+?$)|dummy|^ignored_|^unused_

[IMPORTS]
import-graph=
known-third-party=fastapi,uvicorn,pydantic,rich,dotenv,llama_index,langfuse,openinference
init-hook=import sys; sys.path.append('.')